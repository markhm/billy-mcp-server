{
  "name": "billy-mcp-server",
  "version": "2.1.0",
  "description": "MCP server for Billy accounting system integration",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "billy-mcp-server": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:connection": "node test-connection.js"
  },
  "keywords": [
    "mcp",
    "billy",
    "accounting",
    "invoicing",
    "api"
  ],
  "author": "Mark HM",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
