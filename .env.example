# Billy API access token (required)
# Create one in Billy: Settings -> Access tokens
BILLY_ACCESS_TOKEN=your_billy_access_token_here

# Organisation ID (optional)
# Billy access tokens are organisation-scoped, so this is normally inferred.
# Set it only if the API rejects create calls for a missing organizationId.
# BILLY_ORGANIZATION_ID=

# Write access (optional, off by default)
# The server is read-only unless this is set: the 7 mutating tools are not
# registered and the client refuses any non-GET request. Billy has no read-only
# access token, so this is the only place the restriction can be enforced.
# Uncomment only if you actually need to create or edit records.
# BILLY_ALLOW_WRITES=true

# API base URL (optional) - override only for testing against a different host
# BILLY_API_BASE_URL=https://api.billysbilling.com/v2
